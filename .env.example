APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vet_clinic_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Authentication (Google sign-in).
# Take these four values from the Firebase console: Project settings > Your apps
# > the web app > SDK setup and configuration. They are all public by design —
# they identify the project, they do not authorise anything. The security
# boundary is FIREBASE_PROJECT_ID, which the server checks a token's audience
# against, so a token minted for another project cannot be replayed here.
# Vite inlines the VITE_-prefixed copies into the browser bundle, which is why
# the same values appear twice.
# Set FIREBASE_ENABLED=false to stand the Google button down and use the
# password (Breeze) sign-in screens instead.
FIREBASE_ENABLED=true
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_REDIRECT_TO=/dashboard
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Android SMS Gateway (SMS Gateway for Android, capcom6).
# The username and password are the cloud credentials shown in the gateway
# app on the Android phone that actually sends the texts. Leave them blank to
# stand SMS down: appointment status changes still land in the owner portal,
# but no text is sent. Set SMS_GATEWAY_ENABLED=false to disable explicitly.
SMS_GATEWAY_ENABLED=true
SMS_GATEWAY_URL=https://sms.capcom.me/api/3rdparty/v1
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# Online booking (the owner portal's own request flow).
# Set PORTAL_BOOKING_ENABLED=false to close online booking while the desk takes
# the requests itself: the page and the endpoint behind it both read this one
# switch, so a page left open in a tab cannot slip a booking through either.
PORTAL_BOOKING_ENABLED=true

# The clinic's own wall clock.
# Opening hours in Clinic Settings are written on the clinic's clock, so "has
# this slot already gone?" is answered on the same clock. The application runs
# in UTC, so without this a client in Quezon City could still pick this
# morning's times at dinner. Use any PHP timezone identifier.
CLINIC_TIMEZONE=Asia/Manila
